
inventory: item1,item2

scene ime_scene:
    next scene = ime_sledece_scene || null  //ako je null, next vodi do endinga

    states: ime_stanja = netacno, kidnapovan = netacno   //stanja koja koristimo kao neke uslove

    location lokacija1{
            prev location = ime_prethodne_lokacije || null //default null == ista ova lokacija je prethodna
            next location = ime_sledece_lokacije || null //default null == zavrsi se lokacija

            scenario merchant{    //npr, kupovina kod prodavca, te ime scenarija merchant
                text ""Dobrodosli dobrodosli!" rece ni malo sumnjivi prodavac. Izgleda da ti nudi stvari za prodaju"
                choice "Kupi bananu":
                    add banana
                    go ime_lokacije //ili scene ili scenarija
                choice "Kupi mac":
                    add sword
                    go null  //ne sme biti null
                choice "Predaj medaljon" if has medaljon:               // opcija se pojavljuje samo ako igrac ispunjava uslov (u ovom slucaju da ima odredjeni item)
                    go tajni_podrum
                choice "Vrati se u sumu":

            }
            scenario tajni_podrum{
                text "Ispred tebe se nalazi dragulj za kojim tragas od pocetka avanture."
                choice "Pokupi dragulj":
                    add dragulj
                    go sruseni_podrum
                choice "Pokupi dragulj i zameni ga sa kamenom" if has kamen:
                    add dragulj
                    next location || scene  // zavrsi se prica ako nema sledeceg
            }
            scenario sruseni_podrum{
                ...
            }
            scenario suma{
               ...
            }

            if kidnapovan: start scenario = neka_lokacija
            else: start scenario = suma
    }
    start location = lokacija1

